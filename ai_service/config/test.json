{
  "host": "127.0.0.1",
  "port": 8000,
  "api_prefix": "/api/v1",
  "default_mode": "pass",
  "model_version": "yolo-phase-c-v1-test-mock",
  "policy_version": "policy-default-v1-test",
  "enable_metrics_log": false,
  "metrics_log_every_n": 1,
  "enable_debug_controls": true,
  "detector_provider": "mock",
