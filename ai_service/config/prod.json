{
  "host": "0.0.0.0",
  "port": 8000,
  "api_prefix": "/api/v1",
  "default_mode": "pass",
  "model_version": "yolo-phase-c-v1-pretrain",
  "policy_version": "policy-default-v1",
  "enable_metrics_log": true,
  "metrics_log_every_n": 100,
  "enable_debug_controls": false,
  "detector_provider": "yolo",
  "detector_device": "cpu",
  "yolo_model_path": "yolov8n.pt",
  "detection_confidence_threshold": 0.4,
  "inference_image_size": 224,
  "detector_timeout_ms": 120,
  "detect_every_n_frames": 20,
  "bbox_smoothing_alpha": 0.75,
  "blur_method": "gaussian",
  "blur_intensity": 19,
  "output_image_format": "jpeg",
  "output_jpeg_quality": 75,
  "sensitive_labels": [
    "cell phone",
    "laptop",
    "tv",
    "book",
    "person"
  ],
  "face_provider": "insightface",
  "arcface_model_dir": "models/arcface",
  "face_match_threshold": 0.45,
  "face_det_size": 512,
  "face_det_thresh": 0.25,
  "face_detect_every_n_frames": 1,
  "face_model_version": "arcface-phase-d-v1"
}
