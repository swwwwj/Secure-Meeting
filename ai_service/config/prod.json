{
  "host": "0.0.0.0",
  "port": 8000,
  "api_prefix": "/api/v1",
  "default_mode": "pass",
  "model_version": "yolo-phase-c-v1-pretrain",
  "policy_version": "policy-default-v1",
  "enable_metrics_log": true,
  "metrics_log_every_n": 100,
  "enable_debug_controls": false,
  "detector_provider": "yolo",
  "detector_device": "cpu",
  "yolo_model_path": "yolov8n.pt",
  "detection_confidence_threshold": 0.4,
  "inference_image_size": 640,
  "detector_timeout_ms": 180,
  "detect_every_n_frames": 2,
  "bbox_smoothing_alpha": 0.75,
  "blur_method": "gaussian",
  "blur_intensity": 19,
  "sensitive_labels": [
    "cell phone",
    "laptop",
    "tv",
    "book",
    "person"
  ],
  "face_provider": "insightface",
  "arcface_model_dir": "models/arcface",
  "face_match_threshold": 0.45,
  "face_detect_every_n_frames": 2,
  "face_model_version": "arcface-phase-d-v1",
  "default_privacy_protect_mode": "blur",
  "perturbation_provider": "learned",
  "perturbation_weights_path": "training/runs/adversarial_perturbation/weights/best.pt",
  "perturbation_epsilon": 0.06,
  "perturbation_model_version": "adv-perturb-v1"
}
